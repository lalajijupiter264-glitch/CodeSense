# ==============================================================================
# CodeSense Backend Environment Variables
# ==============================================================================

# Application Environment
ENVIRONMENT=production
DEBUG=false
APP_NAME=CodeSense

# Database Connection
# PostgreSQL: postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=postgresql+psycopg2://codesense:codesense_password@localhost:5432/codesense_db
# SQLite Fallback:
# DATABASE_URL=sqlite:///./codesense.db

# AI Explanation Service (Optional)
API_KEY=
AI_API_KEY=
AI_MODEL=gemini-2.5-flash

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# Java Compiler
JAVA_COMPILER_PATH=javac
COMPILATION_TIMEOUT_SECONDS=10
