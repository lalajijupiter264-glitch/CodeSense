# ==============================================================================
# CodeSense — Production Environment Configuration
# ==============================================================================

# Application Environment (production | development | staging)
ENVIRONMENT=production
DEBUG=false
APP_NAME=CodeSense

# Database Connection URL
# Production PostgreSQL (Docker / Render / Railway / Supabase):
DATABASE_URL=postgresql+psycopg2://codesense:codesense_password@localhost:5432/codesense_db
# Local Development SQLite Fallback:
# DATABASE_URL=sqlite:///./codesense.db

# AI Explanation Service (Optional — Built-in Knowledge Base fallback is used if omitted)
# Google Gemini API Key or OpenAI API Key
API_KEY=
AI_API_KEY=
AI_MODEL=gemini-2.5-flash

# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# Java Compiler Settings
JAVA_COMPILER_PATH=javac
COMPILATION_TIMEOUT_SECONDS=10

# Frontend Configuration (Used by Vite during build or runtime)
VITE_API_URL=http://localhost:8000
